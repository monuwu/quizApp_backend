// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id               Int            @id @default(autoincrement())
  title            String         @db.VarChar(255)
  description      String?        @db.Text
  level            String         @db.VarChar(20)
  durationMinutes  Int            @map("duration_minutes")
  passingScore     Int            @default(70) @map("passing_score")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  questions        Question[]
  quizAttempts     QuizAttempt[]
  
  @@index([level], map: "idx_level")
  @@index([isActive], map: "idx_active")
  @@map("quizzes")
}

model Question {
  id             Int       @id @default(autoincrement())
  quizId         Int       @map("quiz_id")
  questionText   String    @map("question_text") @db.Text
  questionType   String    @default("single") @map("question_type") @db.VarChar(20)
  points         Int       @default(1)
  orderNumber    Int       @map("order_number")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options        Option[]
  answers        Answer[]
  
  @@index([quizId], map: "idx_questions_quiz_id")
  @@map("questions")
}

model Option {
  id           Int      @id @default(autoincrement())
  questionId   Int      @map("question_id")
  optionText   String   @map("option_text") @db.Text
  isCorrect    Boolean  @default(false) @map("is_correct")
  orderNumber  Int      @map("order_number")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@index([questionId], map: "idx_options_question_id")
  @@map("options")
}

model QuizAttempt {
  id              Int       @id @default(autoincrement())
  quizId          Int       @map("quiz_id")
  userId          Int?      @map("user_id")
  startTime       DateTime  @default(now()) @map("start_time") @db.Timestamp(6)
  endTime         DateTime? @map("end_time") @db.Timestamp(6)
  expirationTime  DateTime  @map("expiration_time") @db.Timestamp(6)
  status          String    @default("in_progress") @db.VarChar(20)
  score           Int       @default(0)
  totalPoints     Int       @default(0) @map("total_points")
  percentage      Decimal   @default(0.00) @db.Decimal(5, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers         Answer[]
  
  @@index([quizId], map: "idx_quiz_attempts_quiz_id")
  @@index([userId], map: "idx_quiz_attempts_user_id")
  @@index([status], map: "idx_quiz_attempts_status")
  @@index([expirationTime], map: "idx_quiz_attempts_expiration")
  @@map("quiz_attempts")
}

model Answer {
  id                 Int         @id @default(autoincrement())
  attemptId          Int         @map("attempt_id")
  questionId         Int         @map("question_id")
  selectedOptionIds  Json        @map("selected_option_ids") @db.JsonB
  isCorrect          Boolean     @default(false) @map("is_correct")
  pointsEarned       Int         @default(0) @map("points_earned")
  answeredAt         DateTime    @default(now()) @map("answered_at") @db.Timestamp(6)
  
  attempt            QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question           Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId], map: "unique_attempt_question")
  @@index([attemptId], map: "idx_answers_attempt_id")
  @@index([questionId], map: "idx_answers_question_id")
  @@map("answers")
}
